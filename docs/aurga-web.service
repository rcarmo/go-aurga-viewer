[Unit]
Description=AURGA LAN browser bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aurga
Group=aurga
Environment=AURGA_LISTEN=127.0.0.1:9443
EnvironmentFile=-/etc/aurga-web.env
ExecStart=/usr/local/bin/aurga-web -listen ${AURGA_LISTEN} -state-dir /var/lib/aurga-web
StateDirectory=aurga-web
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target

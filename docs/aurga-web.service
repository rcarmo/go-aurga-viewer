[Unit]
Description=AURGA LAN browser bridge (experimental)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/workspace/deployments/aurga-web
ExecStart=/workspace/deployments/aurga-web/aurga-web -device 192.168.1.94 -listen 192.168.1.167:9443 -state-dir /workspace/deployments/aurga-web/state
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/workspace/deployments/aurga-web/state
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
